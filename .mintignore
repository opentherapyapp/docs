# Mintlify automatically ignores these files and directories:
# .git, .github, .claude, .agents, .idea, node_modules,
# README.md, LICENSE.md, CHANGELOG.md, CONTRIBUTING.md

# Draft content
drafts/
*.draft.mdx

# The screenshot tooling. `images/` is published; the scripts that write it,
# and Playwright's traces when one fails, are not.
scripts/
test-results/
playwright-report/
